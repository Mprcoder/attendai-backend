# ============================================================================
# AttendAI (Virtual Coordinator AI) - Environment Configuration
# ============================================================================

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
SECRET_KEY="replace_with_a_strong_random_secret_key"

# Supabase Configuration (PostgreSQL Database)
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"

# ElevenLabs Conversational AI Configuration (Outbound Calling)
# Found in ElevenLabs Dashboard -> Conversational AI -> Agents & Phone Numbers
ELEVENLABS_API_KEY="xi-api-key-your-elevenlabs-secret"
ELEVENLABS_AGENT_ID="your-elevenlabs-agent-id"
ELEVENLABS_PHONE_NUMBER_ID="your-elevenlabs-twilio-phone-number-id"
ELEVENLABS_WEBHOOK_SECRET="optional-webhook-hmac-secret"

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
